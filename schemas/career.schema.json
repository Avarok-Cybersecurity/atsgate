{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSGate career file",
  "description": "JSON Resume v1.0.0 fields plus the x-atsgate extension.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "awards": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Award"
      }
    },
    "basics": {
      "$ref": "#/$defs/Basics"
    },
    "certificates": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Certificate"
      }
    },
    "education": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Education"
      }
    },
    "interests": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Keywords"
      }
    },
    "languages": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Language"
      }
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meta"
        },
        {
          "type": "null"
        }
      ]
    },
    "projects": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Project"
      }
    },
    "publications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Publication"
      }
    },
    "references": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Keywords"
      }
    },
    "volunteer": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Volunteer"
      }
    },
    "work": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Work"
      }
    },
    "x-atsgate": {
      "$ref": "#/$defs/Extension"
    }
  },
  "additionalProperties": false,
  "required": [
    "basics",
    "x-atsgate"
  ],
  "$defs": {
    "Award": {
      "type": "object",
      "properties": {
        "awarder": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Basics": {
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "profiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Profile"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/BasicsExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "BasicsExtension": {
      "description": "The longer form of `basics.name`, which is the name a resume prints.",
      "type": "object",
      "properties": {
        "full_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Certificate": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Display": {
      "description": "Presentation hints for a site. The resume renderers never read them.",
      "type": "object",
      "properties": {
        "icon": {
          "description": "An icon name from the site's own icon set.",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/Image"
            },
            {
              "type": "null"
            }
          ]
        },
        "logo": {
          "description": "A site asset path, such as `/logos/acme.svg`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Education": {
      "type": "object",
      "properties": {
        "area": {
          "type": [
            "string",
            "null"
          ]
        },
        "courses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": [
            "string",
            "null"
          ]
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "studyType": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "institution"
      ]
    },
    "Engagement": {
      "description": "How a role was held.",
      "type": "string",
      "enum": [
        "employee",
        "contract",
        "founder"
      ]
    },
    "Extension": {
      "description": "The top-level extension.",
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Family"
          }
        },
        "focus_areas": {
          "description": "Areas of expertise, each a name and a sentence; for a site, not for the resume.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/FocusArea"
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "$ref": "#/$defs/Source"
            }
          }
        },
        "variants": {
          "$ref": "#/$defs/Variants"
        },
        "version": {
          "description": "The extension format version this file follows.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "families",
        "variants"
      ]
    },
    "Family": {
      "description": "Related products shown together, by project id.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "members"
      ]
    },
    "FocusArea": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "summary"
      ]
    },
    "Id": {
      "description": "A stable identifier: lowercase letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "Image": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "alt",
        "width",
        "height"
      ]
    },
    "IsoDate": {
      "description": "ISO 8601 date: YYYY, YYYY-MM or YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[1-2][0-9]{3}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "ItemExtension": {
      "description": "The extension on one entry. The kind-specific fields are rejected on other kinds.",
      "type": "object",
      "properties": {
        "category": {
          "description": "Projects only: a short category line.",
          "type": [
            "string",
            "null"
          ]
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/Display"
            },
            {
              "type": "null"
            }
          ]
        },
        "engagement": {
          "description": "Work only.",
          "anyOf": [
            {
              "$ref": "#/$defs/Engagement"
            },
            {
              "type": "null"
            }
          ]
        },
        "highlights": {
          "description": "Publications only: highlights, as JSON Resume gives work and projects.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "description": "Referenced by tailoring files, families and awards.",
          "$ref": "#/$defs/Id"
        },
        "location": {
          "description": "Education only: where the institution is.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "A note for whoever maintains the file. Never rendered.",
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "Publications only: an identifier such as a patent number.",
          "type": [
            "string",
            "null"
          ]
        },
        "on_resume": {
          "description": "Whether the source format listed the entry on its resume. Tailoring files decide what a\nresume shows; this keeps an imported file lossless.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "repo": {
          "description": "Projects only: the source repository.",
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "description": "Ids of entries in the top-level `x-atsgate.sources`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "stats": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Stat"
          }
        },
        "subject": {
          "description": "Awards only: the id of the entry this award recognizes.",
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "description": "Education only: a description of the studies.",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "description": "Work only: the team, division or product inside the organization.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sources"
      ]
    },
    "Keywords": {
      "description": "A named group of keywords (`skills`, `interests`).",
      "type": "object",
      "properties": {
        "keywords": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Language": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "language"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "countryCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "postalCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastModified": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "ProfileExtension": {
      "type": "object",
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ProfileKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "ProfileKind": {
      "description": "Whether a profile is a way to reach the person or a product they made.",
      "type": "string",
      "enum": [
        "identity",
        "product"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "highlights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Publication": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "releaseDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Reference": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Source": {
      "description": "Where a fact came from. At most one of `url` or `path` locates it; a source with neither is\nan unlocated statement (for example a figure the owner stated) and reads as unverified.",
      "type": "object",
      "properties": {
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "$ref": "#/$defs/IsoDate"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "retrieved"
      ]
    },
    "Stat": {
      "description": "A statistic and the evidence for it. A statistic without a source is invalid.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "$ref": "#/$defs/IsoDate"
        },
        "source": {
          "description": "What the figure was read from: a source id or a description of the measurement.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "source",
        "retrieved"
      ]
    },
    "Variants": {
      "description": "Alternative phrasings a tailoring file may choose between. It may never add new ones.",
      "type": "object",
      "properties": {
        "summaries": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "type": "string"
            }
          }
        },
        "titles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "summaries",
        "titles"
      ]
    },
    "Volunteer": {
      "type": "object",
      "properties": {
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "highlights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "organization"
      ]
    },
    "Work": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "endDate": {
          "description": "Absent with a start date means the role is current.",
          "anyOf": [
