{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSGate career file",
  "description": "JSON Resume v1.0.0 fields plus the x-atsgate extension.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "awards": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Award"
      }
    },
    "basics": {
      "$ref": "#/$defs/Basics"
    },
    "certificates": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Certificate"
      }
    },
    "education": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Education"
      }
    },
    "interests": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Keywords"
      }
    },
    "languages": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Language"
      }
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meta"
        },
        {
          "type": "null"
        }
      ]
    },
    "projects": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Project"
      }
    },
    "publications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Publication"
      }
    },
    "references": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "skills": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Keywords"
      }
    },
    "volunteer": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Volunteer"
      }
    },
    "work": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Work"
      }
    },
    "x-atsgate": {
      "$ref": "#/$defs/Extension"
    }
  },
  "additionalProperties": false,
  "required": [
    "basics",
    "x-atsgate"
  ],
  "$defs": {
    "Award": {
      "type": "object",
      "properties": {
        "awarder": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Basics": {
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "profiles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Profile"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Certificate": {
      "type": "object",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Education": {
      "type": "object",
      "properties": {
        "area": {
          "type": [
            "string",
            "null"
          ]
        },
        "courses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": [
            "string",
            "null"
          ]
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "studyType": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "institution"
      ]
    },
    "Extension": {
      "description": "The top-level extension.",
      "type": "object",
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Family"
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "$ref": "#/$defs/Source"
            }
          }
        },
        "variants": {
          "$ref": "#/$defs/Variants"
        },
        "version": {
          "description": "The extension format version this file follows.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "families",
        "variants"
      ]
    },
    "Family": {
      "description": "Related products shown together, by project id.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "members"
      ]
    },
    "Id": {
      "description": "A stable identifier: lowercase letters, digits and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "IsoDate": {
      "description": "ISO 8601 date: YYYY, YYYY-MM or YYYY-MM-DD.",
      "type": "string",
      "pattern": "^[1-2][0-9]{3}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "ItemExtension": {
      "description": "The per-item extension on work, volunteer, education and project entries.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Referenced by tailoring files and families.",
          "$ref": "#/$defs/Id"
        },
        "sources": {
          "description": "Ids of entries in the top-level `x-atsgate.sources`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        },
        "stats": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Stat"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "sources"
      ]
    },
    "Keywords": {
      "description": "A named group of keywords (`skills`, `interests`).",
      "type": "object",
      "properties": {
        "keywords": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Language": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "language"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "countryCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "postalCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastModified": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Profile": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "highlights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Publication": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "releaseDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Reference": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Source": {
      "description": "Where a fact came from. Exactly one of `url` or `path` locates it.",
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "$ref": "#/$defs/IsoDate"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "retrieved"
      ]
    },
    "Stat": {
      "description": "A statistic and the evidence for it. A statistic without a source is invalid.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved": {
          "$ref": "#/$defs/IsoDate"
        },
        "source": {
          "description": "What the figure was read from: a source id or a description of the measurement.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "source",
        "retrieved"
      ]
    },
    "Variants": {
      "description": "Alternative phrasings a tailoring file may choose between. It may never add new ones.",
      "type": "object",
      "properties": {
        "summaries": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "type": "string"
            }
          }
        },
        "titles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9][a-z0-9-]*$": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "summaries",
        "titles"
      ]
    },
    "Volunteer": {
      "type": "object",
      "properties": {
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "highlights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": [
            "string",
            "null"
          ]
        },
        "startDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "organization"
      ]
    },
    "Work": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "highlights": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "startDate": {
          "$ref": "#/$defs/IsoDate"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "x-atsgate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemExtension"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "position",
        "startDate"
      ]
    }
  }
}
